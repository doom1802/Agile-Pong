NEXT_PUBLIC_APP_NAME=Agile Pong
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Required for the default Supabase backend. Mock mode must be selected explicitly below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key used exclusively by the token-protected Quick Insert command.
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_EMAIL_DOMAIN=agilelab.it
# Use a long random value and encode /quick/<token> in the QR code.
QUICK_INSERT_TOKEN=
# Optional comma-separated public office IPs. Leave empty to allow any network.
QUICK_INSERT_ALLOWED_IPS=
# Optional escape hatch for isolated UI development. Supabase is the default.
DATA_BACKEND=supabase
AUTH_BACKEND=supabase
MOCK_LOGIN_CODE=123456
